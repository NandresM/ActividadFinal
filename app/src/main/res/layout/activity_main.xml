<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscador de Libros"
        android:textSize="24sp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editTextBusqueda"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:hint="Buscar libros..."
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/botonBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLibros"
        android:layout_width="match_parent"
        android:layout_height="561dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Libros de API" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#CCCCCC"
        >

        <Button
            android:id="@+id/botonEstanteria"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"

            android:contentDescription="Ir a Mi Estantería"
            android:text="@string/botonEstanteria"/>
        <Button
            android:id="@+id/botonLaCerrarSesion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="Cerrar Sesión"
            android:text="@string/botonLaCerrarSesion"

            />

    </LinearLayout>

</LinearLayout>